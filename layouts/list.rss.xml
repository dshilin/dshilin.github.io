{{- $articles := partial "journal-articles.html" .Site -}}
{{- if eq .Kind "term" -}}{{- $articles = intersect $articles .Pages -}}{{- end -}}
{{- if and (not .IsHome) (ne .Section "blog") (ne .Kind "term") -}}{{- $articles = intersect $articles .RegularPagesRecursive -}}{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }} – {{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Title }}: статьи</description>
    <language>{{ .Site.Language.Lang }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range $articles }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}
      <description>{{ .Description | default (.Summary | plainify) }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
